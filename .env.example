# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Comma-separated Telegram numeric user IDs allowed to command the bot.
# Empty = deny everyone (safe default). Get your ID from @userinfobot.
ALLOWED_USER_IDS=

# --- Wallet ---
# Primary minting wallet (required). NEVER commit the real .env.
PRIVATE_KEY=0xyourprivatekey
# Optional extra wallets for multi-wallet mint (comma-separated private keys).
PRIVATE_KEYS=
# Optional: path to a JSON wallets file. Format: ["0xpk", ...] or [{"pk":"0x.."}]
WALLETS_FILE=wallets.json

# --- Optional: OpenSea slug resolution ---
OPENSEA_KEY=

# --- RPC overrides (defaults are public endpoints) ---
RPC_ETH=https://eth.llamarpc.com
RPC_BASE=https://mainnet.base.org
RPC_POLYGON=https://polygon-rpc.com
RPC_ARB=https://arb1.arbitrum.io/rpc
RPC_OP=https://mainnet.optimism.io
RPC_ZORA=https://rpc.zora.energy
RPC_BSC=https://bsc-rpc.publicnode.com
RPC_AVAX=https://avalanche-c-chain-rpc.publicnode.com
RPC_BERA=https://rpc.berachain.com
RPC_PEAQ=https://peaq-rpc.publicnode.com
RPC_ROBINHOOD=https://robinhood-rpc.publicnode.com
